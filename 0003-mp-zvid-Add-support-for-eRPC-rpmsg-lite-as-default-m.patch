diff --git a/subsys/mp/plugins/zvid/mp_zvid_transform_client_erpc.c b/subsys/mp/plugins/zvid/mp_zvid_transform_client_erpc.c
new file mode 100644
index 00000000000..cff8d6d37f9
--- /dev/null
+++ b/subsys/mp/plugins/zvid/mp_zvid_transform_client_erpc.c
@@ -0,0 +1,57 @@
+
+/*
+ * Copyright 2026 NXP
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <zephyr/logging/log.h>
+
+#include <zephyr/mp/core/mp_transform_client.h>
+#include <zephyr/mp/core/rpc/erpc/erpc_error_handler.h>
+#include <zephyr/mp/zvid/mp_zvid_transform_client.h>
+#include <zephyr/mp/zvid/mp_zvid_transform_client_erpc.h>
+
+#include "erpc_client_setup.h"
+#include "c_mp_zvid_transform_client.h"
+#include "mp_zvid_transform_common.h"
+
+/* Delay needed for the remote to be able to reset */
+#define ERPC_INIT_DELAY_MS (300U)
+
+LOG_MODULE_REGISTER(mp_zvid_transform_client_erpc, CONFIG_MP_LOG_LEVEL);
+
+static int init_erpc(void)
+{
+	erpc_transport_t transport = erpc_transport_zephyr_ipc_master_init(
+		CONFIG_ERPC_ENDPOINT_NAME, ERPC_INIT_DELAY_MS);
+
+	if (transport == NULL) {
+		printk("ERROR: Failed to initialize eRPC transport\r\n");
+		return -EIO;
+	}
+
+	erpc_mbf_t message_buffer_factory = erpc_mbf_ipc_service_init(transport);
+	erpc_client_t client = erpc_client_init(transport, message_buffer_factory);
+
+	initMPService_client(client);
+	erpc_client_set_error_handler(client, erpc_error_handler);
+
+	return 0;
+}
+
+void mp_zvid_transform_client_erpc_init(struct mp_element *self)
+{
+	struct mp_transform_client *tc = (struct mp_transform_client *)self;
+	struct mp_zvid_transform_client *vtc = (struct mp_zvid_transform_client *)self;
+
+	tc->init_rpc = init_erpc;
+	tc->chainfn_rpc = chainfn_rpc;
+
+	vtc->get_buf_caps_rpc = get_buf_caps_rpc;
+	vtc->get_format_caps_rpc = get_format_caps_rpc;
+	vtc->set_format_rpc = set_format_rpc;
+	vtc->transform_cap_rpc = transform_cap_rpc;
+
+	mp_zvid_transform_client_init(self);
+}
