diff --git a/subsys/mp/plugins/zvid/CMakeLists.txt b/subsys/mp/plugins/zvid/CMakeLists.txt
index bce9bf50a2d..d236f674c98 100644
--- a/subsys/mp/plugins/zvid/CMakeLists.txt
+++ b/subsys/mp/plugins/zvid/CMakeLists.txt
@@ -20,3 +20,38 @@ zephyr_library_sources_ifdef(CONFIG_MP_RPC
     mp_zvid_buffer_pool_client.c
     mp_zvid_transform_client.c
 )
+
+if(CONFIG_MP_RPC_BACKEND_ERPC)
+    find_program(ERPCGEN erpcgen REQUIRED)
+    set(ERPC_DIR ${CMAKE_CURRENT_LIST_DIR}/erpc)
+    set(ERPC_GENERATED_DIR ${ZEPHYR_BINARY_DIR}/generated/erpc)
+    set(ERPC_GENERATED_FILES
+        ${ERPC_GENERATED_DIR}/mp_zvid_transform_common.h
+        ${ERPC_GENERATED_DIR}/c_mp_zvid_transform_client.h
+        ${ERPC_GENERATED_DIR}/c_mp_zvid_transform_client.cpp
+        ${ERPC_GENERATED_DIR}/mp_zvid_transform_client.cpp
+        ${ERPC_GENERATED_DIR}/mp_zvid_transform_interface.cpp
+    )
+    add_custom_command(
+        OUTPUT ${ERPC_GENERATED_FILES}
+        COMMAND
+        ${ERPCGEN} -v -g c -o ${ERPC_GENERATED_DIR} ${ERPC_DIR}/mp_zvid_transform.erpc
+        COMMAND
+        ${CMAKE_COMMAND} -E rm -f ${ERPC_GENERATED_DIR}/*server.cpp ${ERPC_GENERATED_DIR}/*server.h ${ERPC_GENERATED_DIR}/*server.hpp
+        DEPENDS
+        ${ERPC_DIR}/mp_zvid_transform.erpc
+        ${ERPC_DIR}/external.h
+    )
+    add_custom_target(generate_erpc_client DEPENDS ${ERPC_GENERATED_FILES})
+    add_dependencies(${ZEPHYR_CURRENT_LIBRARY} generate_erpc_client)
+    # The generated eRPC sources include "external.h", which is provided in the
+    # source erpc directory. Add it (and the generated directory) to the include
+    # path so the generated code can be compiled.
+    zephyr_library_include_directories(${ERPC_DIR} ${ERPC_GENERATED_DIR})
+    zephyr_library_sources(
+        mp_zvid_transform_client_erpc.c
+        ${ERPC_GENERATED_DIR}/c_mp_zvid_transform_client.cpp
+        ${ERPC_GENERATED_DIR}/mp_zvid_transform_client.cpp
+        ${ERPC_GENERATED_DIR}/mp_zvid_transform_interface.cpp
+    )
+endif()
