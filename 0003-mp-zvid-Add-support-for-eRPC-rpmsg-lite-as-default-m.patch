+/*
+ * Copyright 2026 NXP
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#ifndef __EMBEDDED_RPC_EXTERNAL_H__
+#define __EMBEDDED_RPC_EXTERNAL_H__
+
+#include <zephyr/drivers/video.h>
+
+#include <zephyr/mp/core/mp_pad.h>
+
+/* typedef for @external has to be done manually as it is not automatically generated by erpcgen */
+typedef struct video_format video_format;
+typedef struct video_format_cap video_format_cap;
+typedef enum mp_pad_direction mp_pad_direction;
+typedef enum video_buf_type video_buf_type;
+
+#endif /* __EMBEDDED_RPC_EXTERNAL_H__ */
diff --git a/subsys/mp/plugins/zvid/erpc/mp_zvid_transform.erpc b/subsys/mp/plugins/zvid/erpc/mp_zvid_transform.erpc
new file mode 100644
index 00000000000..c5b00274e4a
--- /dev/null
+++ b/subsys/mp/plugins/zvid/erpc/mp_zvid_transform.erpc
@@ -0,0 +1,48 @@
+/*!
+ * Copyright 2026 NXP
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+@c: include("external.h")
+
+program mp_zvid_transform
+
+@external enum video_buf_type {
+	VIDEO_BUF_TYPE_INPUT = 1,
+	VIDEO_BUF_TYPE_OUTPUT = 2
+}
+
+@external struct video_format {
+	video_buf_type queue_type @name("type"); /* IDL uses queue_type, C uses type */
+	uint32 pixelformat;
+	uint32 width;
+	uint32 height;
+	uint32 pitch;
+	uint32 size;
+}
+
+@external struct video_format_cap {
+	uint32 pixelformat;
+	uint32 width_min;
+	uint32 width_max;
+	uint32 height_min;
+	uint32 height_max;
+	uint16 width_step;
+	uint16 height_step;
+}
+
+@external enum mp_pad_direction {
+	MP_PAD_UNKNOWN = 0,
+	MP_PAD_SRC = 1,
+	MP_PAD_SINK = 2
+}
+
+interface MPService
+{
+	get_buf_caps_rpc(in mp_pad_direction direction, out uint8 min_buffers, out uint16 buf_align) -> int32
+	get_format_caps_rpc(in mp_pad_direction direction, in uint8 ind, out video_format_cap vfc) -> int32
+	set_format_rpc(inout video_format fmt) -> int32
+	transform_cap_rpc(in mp_pad_direction direction, in uint16 ind, in video_format_cap vfc, out video_format_cap other_vfc) -> int32
+	chainfn_rpc(in uint32 in_buf, in uint32 in_sz, in uint32 out_buf, out uint32 out_sz) -> int32
+}
