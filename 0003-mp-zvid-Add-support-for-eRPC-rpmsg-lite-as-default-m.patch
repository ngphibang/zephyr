+
+/**
+ * @file
+ * @brief Main header for zvid transform client element which uses eRPC.
+ */
+
+#ifndef ZEPHYR_INCLUDE_MP_ZVID_MP_ZVID_TRANSFORM_CLIENT_ERPC_H_
+#define ZEPHYR_INCLUDE_MP_ZVID_MP_ZVID_TRANSFORM_CLIENT_ERPC_H_
